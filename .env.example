PORT=4000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use a server-side service-role key only. Never put it in frontend files.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-secret-service-role-key
SUPABASE_STORAGE_BUCKET=learning-pdfs
# comma-separated exact origins, no trailing slash
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,https://iqrailmspace.in,https://www.iqrailmspace.in
# Firebase Authentication UID(s) of authorized administrators, not email addresses.
ADMIN_FIREBASE_UIDS=replace-with-your-admin-firebase-uid
# Future payment/email integration placeholders; do not fill until provider chosen.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
PAYMENT_FROM_EMAIL=payments@iqrailmspace.in
SUPPORT_EMAIL=support@iqrailmspace.in
INFO_EMAIL=iqrailmspace.info@gmail.com
ADMIN_EMAIL=admin@iqrailmspace.in
